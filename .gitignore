# Don't commit Garmin tokens
.garminconnect/

# Activity database — large, rebuilt locally with scripts/build_db.py
data/activities.json

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# macOS
.DS_Store

# Editor
.vscode/
*.swp

# Large data - keep activities.json but ignore future big exports
data/raw/

# Raw FIT archive — LOCAL ONLY, deliberately not committed.
# These contain GPS position_lat/position_long for every second, i.e. home
# address and daily routine. This repo is published via GitHub Pages, so
# committing them would make that data publicly downloadable.
# The archive is ~45MB, 184 files. Rebuild with:
#   ~/.cache/uv/archive-v0/kKQyyZw9eWA6xSrfjm0LO/bin/python3 scripts/fit_to_db.py
data/fit-raw/

# Binary series cache (.npz per-second numpy arrays) — regenerable from fit-raw
# ~10MB, 184 files, no value in version control
data/series/

# Deep analysis JSON cache — regenerable from fit-raw via fit_deep.py
# Superseded by training.db which is now the canonical store
data/deep/
