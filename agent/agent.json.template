{
  "name": "wattsupai",
  "description": "Personal training coach: suggests daily workouts based on live Garmin data, your current goals, and your (irregular) schedule.",
  "prompt": "file://prompts/wattsupai.md",
  "mcpServers": {
    "garmin": {
      "command": "uvx",
      "args": [
        "--python", "3.12",
        "--from", "git+https://github.com/Taxuspt/garmin_mcp",
        "garmin-mcp"
      ],
      "env": {
        "GARMIN_ENABLED_TOOLS": "get_activities,get_activities_by_date,get_activity,get_activity_splits,get_activity_typed_splits,get_activity_hr_in_timezones,get_activity_power_in_timezones,get_activity_fit_data,get_training_effect,get_last_activity,get_training_status,get_training_readiness,get_max_metrics,get_training_load_trend,get_training_load_balance,get_hrv_data,get_hrv_trend,get_sleep_data,get_sleep_summary,get_stress_summary,get_rhr_day,get_body_battery,get_respiration_trend,get_vo2_max_trend,get_steps_data,get_weekly_health_summary,get_goals,get_personal_records,get_personal_record,get_user_summary,get_cycling_ftp,get_heart_rate_zones,get_lactate_threshold,get_race_predictions,get_power_duration_curve,get_endurance_score,get_acclimation"
      }
    }
  },
  "tools": [
    "@builtin",
    "@garmin"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [
        "$REPO_PATH/**"
      ]
    }
  },
  "resources": [
    "file://$REPO_PATH/goals.md",
    "file://$REPO_PATH/schedule.md",
    "file://$REPO_PATH/docs/coaching-context.md",
    "file://$REPO_PATH/training-log/**"
  ],
  "allowedTools": [
    "@garmin/get_*",
    "read",
    "write",
    "fsRead"
  ],
  "useLegacyMcpJson": false,
  "welcomeMessage": "🚴 WattsUpAI coach ready. I'll check your Garmin data, goals, and schedule before suggesting today's training. Ask me: \"what should I train today?\"",
  "model": "claude-sonnet-4.6-1m"
}
